# Copie este arquivo para ".env" (na pasta backend) e preencha com os dados do Supabase.
# Supabase > Connect > Session pooler
DB_URL=jdbc:postgresql://aws-1-REGIAO.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.SEU_PROJETO
DB_PASSWORD=SUA_SENHA

# Chave usada para assinar o token de login (mínimo 32 caracteres, qualquer texto aleatório)
JWT_SECRET=troque-por-um-texto-aleatorio-com-pelo-menos-32-caracteres
